# Copy to .env.local for development. VITE_* values are public browser settings.
# Development server only. Set the target to the backend origin with no path.
VITE_DEV_PROXY_TARGET=http://localhost:8080
VITE_DEV_PORT=3100

# Browser build settings. Same-origin routing works with the example in deploy/.
VITE_API_BASE_URL=/api/v1
# Optional admin WebSocket host[:port], without a scheme or path. Empty = API origin.
VITE_WS_BASE_URL=
# Fallback while public settings load, or when the backend uses its default name.
VITE_DEFAULT_SITE_NAME=Sub2API
# true shows the built-in landing page even when the backend has custom home content.
VITE_PREVIEW_BUILTIN_HOME=false
