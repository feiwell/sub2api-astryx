js_import nonce from /etc/nginx/nonce.js;
js_set $csp_nonce nonce.createNonce;

upstream sub2api {
    server ${SUB2API_UPSTREAM};
}

map $http_upgrade $upgrade_connection {
    default upgrade;
    ''      '';
}

# Some browsers require explicit WebSocket origins. Accept only host[:port].
map $http_host $socket_sources {
    default '';
    "~^([A-Za-z0-9.-]+|\\[[A-Fa-f0-9:]+\\])(:[0-9]+)?$" "ws://$http_host wss://$http_host";
}

server {
    listen 8080;
    root /srv/astryx;
    absolute_redirect off;
    client_max_body_size 256m;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto ${SUB2API_PUBLIC_SCHEME};
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded '';
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $upgrade_connection;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_redirect off;

    # Application API, OAuth provider callbacks, payment webhooks and gateways.
    # proxy_pass has no URI component so the backend receives the original path.
    location ~ ^/(api|v1|v1beta|backend-api|antigravity)(/|$) {
        proxy_pass http://sub2api;
    }
    location ~ ^/setup/.+ {
        proxy_pass http://sub2api;
    }
    location = /health {
        proxy_pass http://sub2api;
    }
    location ~ ^/\.well-known/(oauth-authorization-server|oauth-protected-resource(/api/v1/mcp)?)/?$ {
        proxy_pass http://sub2api;
    }
    location ~ ^/(models|responses|images|videos|custom-voices|(v3/)?contents/generations/tasks)(/|$) {
        proxy_pass http://sub2api;
    }
    location ~ ^/(chat/completions|messages/count_tokens|alpha/search|embeddings|web_search|x_search|tts|stt|realtime)/?$ {
        proxy_pass http://sub2api;
    }

    # All SPA entry points share one nonce-bearing, non-cacheable HTML response.
    location = /index.html {
        if ($csp_nonce = '') { return 500; }
        etag off;
        if_modified_since off;
        max_ranges 0;
        sub_filter '__CSP_NONCE_VALUE__' $csp_nonce;
        sub_filter_once off;
        add_header Cache-Control 'no-store' always;
        add_header Referrer-Policy 'no-referrer' always;
        add_header X-Content-Type-Options 'nosniff' always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'nonce-$csp_nonce'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' $socket_sources; frame-src 'self'; form-action 'self'" always;
    }

    location = /licenses {
        return 308 /licenses/;
    }
    location ^~ /licenses/ {
        try_files $uri $uri/ =404;
        autoindex on;
        default_type text/plain;
        add_header Cache-Control 'no-cache';
        add_header X-Content-Type-Options 'nosniff' always;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control 'public, max-age=31536000, immutable';
        add_header X-Content-Type-Options 'nosniff' always;
    }
    location ~* \.(js|mjs|css|map|json|html|wasm|svg|png|jpe?g|webp|gif|ico|woff2?|ttf|txt|webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control 'no-cache';
        add_header X-Content-Type-Options 'nosniff' always;
    }

    # Includes /setup, /auth/*/callback, /oauth/mcp/authorize and /payment/result.
    location / {
        try_files $uri /index.html;
    }
}
